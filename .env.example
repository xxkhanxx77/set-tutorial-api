# PostgreSQL connection. Use the Railway PostgreSQL URL or the external proxy URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Settrade Open API credentials.
SETTRADE_APP_ID=your_app_id
SETTRADE_APP_SECRET=your_app_secret
SETTRADE_APP_CODE=ALGO
SETTRADE_BROKER_ID=your_broker_id
SETTRADE_ENV=prod

# Comma-separated symbols to collect. Examples: AOT,PTT,USDM26
# TFEX futures work too, e.g. USD futures (USDM26) and Mini Gold Online futures (MGOM26,MGOU26).
SETTRADE_SYMBOLS=USDM26,MGOM26,MGOU26

# Optional collector behavior.
ENABLE_COLLECTOR=true
SUBSCRIBE_PRICE_INFO=true
SNAPSHOT_MIN_INTERVAL_MS=0
LOG_LEVEL=INFO

# Optional Binance TH order book collector. Public market data; no API key needed.
# PAXGUSDT is PAXG/USDT (1 PAXG = 1 troy oz of gold) for the gold spread vs TFEX MGO.
ENABLE_BINANCE_TH_COLLECTOR=false
BINANCE_TH_SYMBOLS=USDTTHB,PAXGUSDT
BINANCE_TH_DEPTH_LIMIT=10
BINANCE_TH_POLL_INTERVAL_SECONDS=1.0

# Optional Bybit TradFi quote collector. USDTHB+ exposes top bid/ask quotes, not depth.
ENABLE_BYBIT_TRADFI_COLLECTOR=false
BYBIT_TRADFI_SYMBOLS=USDTHB+
BYBIT_TRADFI_POLL_INTERVAL_SECONDS=1.0
BYBIT_TRADFI_CANDLE_INTERVAL=30
BYBIT_TRADFI_CANDLE_LIMIT=2
BYBIT_TRADFI_CANDLE_POLL_INTERVAL_SECONDS=60.0
